{
  "name": "3dmeshtools.com",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "concurrently \"npm run dev:*\"",
    "dev:11ty": "NODE_ENV=dev npx @11ty/eleventy --serve --port=8080",
    "dev:tw": "tailwindcss -i src/assets/css/tailwind.css -o _site/assets/css/tailwind.css --watch",
    "build": "ELEVENTY_PRODUCTION=true npx @11ty/eleventy && NODE_ENV=production npx tailwindcss -i src/assets/css/tailwind.css -o _site/assets/css/tailwind.css --minify"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-img": "^7.1.1",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "concurrently": "^10.0.6",
    "daisyui": "^5.7.50",
    "markdown-it-anchor": "^10.0.0",
    "tailwindcss": "^4.3.3"
  }
}
