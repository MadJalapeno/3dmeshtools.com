        <a class="link link-hover" href="/">Home</a> <span aria-hidden="true">/</span> <span>{{ breadcrumb or title }}</span>
    </nav>
    <div class="prose prose-invert prose-lg max-w-none prose-headings:font-bold prose-a:text-primary">
        {{ content | safe }}
    </div>
</article>
